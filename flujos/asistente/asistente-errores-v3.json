    {
      "parameters": {
        "jsCode": "// Evita que un mismo error (p. ej. del Reloj, que corre cada 5-10 min) te llegue a Telegram una y otra vez: máximo 1 por hora\nconst e = $input.first().json;\nconst st = $getWorkflowStaticData('global');\nconst clave = [e.workflow && e.workflow.name, e.execution && e.execution.lastNodeExecuted, String((e.execution && e.execution.error && e.execution.error.message) || '').slice(0, 80)].join('|');\nconst ahora = Date.now();\nst.vistos = Object.fromEntries(Object.entries(st.vistos || {}).filter(([, t]) => ahora - t < 6 * 3600e3));\nif (st.vistos[clave] && ahora - st.vistos[clave] < 3600e3) return [];\nst.vistos[clave] = ahora;\nreturn [$input.first()];\n"
      },
